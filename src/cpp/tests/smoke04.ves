def dbl(x)-
-back(x * '2')

def gt0(x)-
-back(x > '0')

def size(s)-
-back(#len(s))

/* 0.4 通用编程语言扩充 - 冒烟测试（确定性部分） */
print("-sqrt(16) ="; #sqrt('16'))
print("-floor(3.7) ="; #floor('3.7'))
print("-ceil(3.2) ="; #ceil('3.2'))
print("-exp(0) ="; #exp('0'))
print("-log(1) ="; #log('1'))
print("-log10(1000) ="; #log10('1000'))
print("-sin(0) ="; #sin('0'))
print("-cos(0) ="; #cos('0'))
print("-tan(0) ="; #tan('0'))
print("-sign(-5) ="; #sign('-5'); "-sign(0) ="; #sign('0'))
print("-clamp(15; 0; 10) ="; #clamp('15'; '0'; '10'))
print("-hex(255) ="; #hex('255'))
print("-bin(5) ="; #bin('5'))
print("-oct(8) ="; #oct('8'))
print("-pad ="; #pad("ab"; '6'; "*"))
print("-lpad ="; #lpad("ab"; '5'; "0"))
print("-rpad ="; #rpad("ab"; '5'; "0"))
print("-format ="; #format("%s-%d-%.2f"; "v"; '42'; '3.14159'))
print("-hash('hello') ="; #hash("hello"))
print("-range(1; 5) ="; #range('1'; '5'))
print("-range(5; 1; -2) ="; #range('5'; '1'; '-2'))
print("-first ="; #first(['1'; '2'; '3']); "-last ="; #last(['1'; '2'; '3']))
print("-take ="; #take(['1'; '2'; '3'; '4']; '2'); "-drop ="; #drop(['1'; '2'; '3'; '4']; '2'))
print("-set ="; #set(['1'; '1'; '2'; '3'; '3']))
print("-flatten ="; #flatten([['1'; '2']; ['3'; ['4']]]))
print("-zip ="; #zip(['1'; '2'; '3']; ["a"; "b"]))
print("-insert ="; #insert(['1'; '2'; '3']; '2'; '99'))
print("-remove ="; #remove(['1'; '2'; '3']; '2'))
print("-index_of ="; #index_of(['10'; '20'; '30']; '20'))
print("-enumerate ="; #enumerate(["a"; "b"]))
print("-concat ="; #concat(['1'; '2']; ['3'; '4']))
d = {"x": '1'; "y": '2'}
print("-get ="; #get(d; "x"); "-get default ="; #get(d; "z"; '9'))
print("-items ="; #items(d))
print("-pop_key ="; #pop_key(d; "x"); "-after ="; #keys(d))
print("-is_str ="; #is_str("a"); "-is_int ="; #is_int('1'); "-is_float ="; #is_float('1.5'))
print("-is_bool ="; #is_bool(true); "-is_list ="; #is_list([]); "-is_dict ="; #is_dict(d))
print("-is_none ="; #is_none(none); "-is_group ="; #is_group(("a"; "b")))
print("-base64_encode ="; #base64_encode("hello"))
print("-base64_decode ="; #base64_decode("aGVsbG8="))
print("-url_encode ="; #url_encode("a b&c"))
print("-url_decode ="; #url_decode("a+b%26c"))
print("-platform ="; #platform())
print("-temp_dir ="; #temp_dir())
print("-first none ="; #first([]))
print("-each ="; #each(['1'; '2'; '3']; "dbl"))
print("-all ="; #all(['1'; '2'; '3']; "gt0"); "-any ="; #any(['-1'; '2']; "gt0"))
print("-find_first ="; #find_first(['-1'; '2'; '-3']; "gt0"))
print("-sort_by ="; #sort_by(["ccc"; "a"; "bb"]; "size"))
print("-assert ok ="; #assert('1' == '1'; "msg"))
print("-shuffle type ="; #type(#shuffle(['1'; '2'; '3'])))
print("-rand type ="; #type(#rand()))
print("-randint type ="; #type(#randint('1'; '10')))
print("-now type ="; #type(#now()))
print("-date len ="; #len(#date()))
print("-ticks type ="; #type(#ticks()))
