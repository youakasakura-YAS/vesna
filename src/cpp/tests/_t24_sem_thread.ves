/* 2.4 信号量跨线程同步测试 */
sem = #sem_open('0'),
done = ['0'],
def worker()-
-#sem_wait(sem),
-done['1'] = '1',
-print("worker 放行"),

#thread(worker),
#sleep('100'),
print("主线程: worker 应仍阻塞"),
if done['1'] == '0'-
