/* Vesna 包管理器（vpm）—— vesna --pkg */

import json,

args = #args(),
home = #getenv("VESNA_HOME"),
if home == ""-
-home = "C:\\Vesna",
pkgs = home + "\\packages",
reg_file = home + "\\registry.json",
default_reg = "https://youakasakura-YAS.github.io/vesna-pkg/registry.json",

def pkg_help()-
-print("Vesna 包管理器 vpm"),
-print("用法: vesna --pkg <命令> [参数]"),
-print("  init                    初始化当前目录为包"),
-print("  install <源>            安装包（目录 / zip / owner:repo / registry 包名）"),
-print("  remove <名称>           卸载包"),
-print("  list                    列出已安装包"),
-print("  search <关键词>         搜索 registry 索引"),
-print("  registry <URL>          更新 registry 索引缓存"),

def read_json(path)-
-if not #fexists(path)-
--back(none),
-t = #fread(path),
-try-
--back(json_parse(t)),
-catch e-
--print("  JSON 解析失败: " + path),
--back(none),

def pkg_version_of(dir)-
-meta = read_json(dir + "\\vesna-pkg.json"),
-if meta == none or #type(meta) != "dict" or not #has_key(meta; "version")-
--back("0.0.0"),
-back(meta["version"]),

def unzip(zip_path; dest_dir)-
-#mkdirs(dest_dir),
-plat = #platform(),
-if #find(plat; "windows") != '0'-
--#shell("powershell -NoProfile -Command \"Expand-Archive -Force -Path '" + zip_path + "' -DestinationPath '" + dest_dir + "'\""),
-else-
--#shell("tar -xf \"" + zip_path + "\" -C \"" + dest_dir + "\""),
-if #fexists(dest_dir + "\\vesna-pkg.json")-
--back(dest_dir),
-entries = #ls(dest_dir),
-for ent in entries-
--if #fexists(dest_dir + "\\" + ent + "\\vesna-pkg.json")-
---back(dest_dir + "\\" + ent),
-back(dest_dir),

def install_from_dir(src)-
-meta = read_json(src + "\\vesna-pkg.json"),
-if meta == none or #type(meta) != "dict"-
--print("  错误: 源不是 Vesna 包（缺少 vesna-pkg.json）"),
--back(false),
-if not #has_key(meta; "name")-
--print("  错误: vesna-pkg.json 缺少 name"),
--back(false),
-name = meta["name"],
-ver = pkg_version_of(src),
-print("  安装 " + name + " " + ver + " ..."),
-#mkdirs(pkgs),
-target = pkgs + "\\" + name,
-if #fexists(target)-
--#rmdir(target),
-#cpdir(src; target),
-if not #fexists(target + "\\vesna-pkg.json")-
--print("  错误: 复制失败"),
--back(false),
-if #has_key(meta; "dependencies")-
--deps = meta["dependencies"],
--if #type(deps) == "dict"-
---for dep_name in #keys(deps)-
----if dep_name != name and not #fexists(pkgs + "\\" + dep_name) and not #fexists(pkgs + "\\" + dep_name + "\\vesna-pkg.json")-
-----print("  依赖 " + dep_name + " 未安装，请手动: vesna --pkg install <" + dep_name + " 的源>"),
-print("  完成: " + name + " " + ver),
-back(true),

def install_zip(zip_path)-
-tmp = home + "\\packages\\_tmp",
-if #fexists(tmp)-
--#rmdir(tmp),
-#mkdirs(tmp),
-root = unzip(zip_path; tmp),
-ok = install_from_dir(root),
-if #fexists(tmp)-
--#rmdir(tmp),
-back(ok),

def fetch_registry()-
-if #fexists(reg_file)-
--back(read_json(reg_file)),
-print("下载 registry 索引 ..."),
-#shell("curl -L -s -o \"" + reg_file + "\" \"" + default_reg + "\""),
-if #fexists(reg_file)-
--back(read_json(reg_file)),
-print("错误: registry 索引下载失败（可手动: vesna --pkg registry <URL>）"),
-back(none),

def install_by_name(name)-
-reg = fetch_registry(),
-if reg == none or #type(reg) != "list"-
--back(false),
-for pkg in reg-
--if #type(pkg) == "dict" and #has_key(pkg; "name") and pkg["name"] == name-
---if not #has_key(pkg; "url")-
----print("  错误: registry 中 " + name + " 缺少 url"),
----back(false),
---tmp_zip = home + "\\packages\\_tmp.zip",
---if #fexists(tmp_zip)-
----#fremove(tmp_zip),
---print("  下载 " + pkg["url"] + " ..."),
---#shell("curl -L -s -o \"" + tmp_zip + "\" \"" + pkg["url"] + "\""),
---if not #fexists(tmp_zip)-
----print("  错误: 下载失败（请检查网络或 registry URL）"),
----back(false),
---ok = install_zip(tmp_zip),
---if #fexists(tmp_zip)-
----#fremove(tmp_zip),
---back(ok),
-print("  registry 中未找到包: " + name),
-print("  可先运行: vesna --pkg registry <URL> 更新索引"),
-back(false),

def install_git(src)-
-tmp_zip = home + "\\packages\\_tmp.zip",
-if #fexists(tmp_zip)-
--#fremove(tmp_zip),
-url = "https://github.com/" + src + "/archive/refs/heads/main.zip",
-print("  下载 " + url + " ..."),
-#shell("curl -L -s -o \"" + tmp_zip + "\" \"" + url + "\""),
-if not #fexists(tmp_zip)-
--print("  错误: 下载失败（请确认源或网络）"),
--back(false),
-ok = install_zip(tmp_zip),
-if #fexists(tmp_zip)-
--#fremove(tmp_zip),
-back(ok),

if #len(args) < '1'-
-pkg_help(),
-#exit('0'),

cmd = args['1'],

if cmd == "init"-
-if #fexists("vesna-pkg.json")-
--print("错误: vesna-pkg.json 已存在"),
--#exit('1'),
-#fwrite("vesna-pkg.json"; "{\n  \"name\": \"mypkg\",\n  \"version\": \"1.0.0\",\n  \"description\": \"\",\n  \"entry\": \"mypkg.ves\",\n  \"dependencies\": {}\n}\n"),
-print("已生成 vesna-pkg.json"),
-#exit('0'),

if cmd == "install"-
-if #len(args) < '2'-
--print("用法: vesna --pkg install <目录|zip|owner:repo>"),
--#exit('1'),
-src = args['2'],
-if #fexists(src) and #is_dir(src)-
--if install_from_dir(src) == false-
---#exit('1'),
-elif #fexists(src) and #is_file(src)-
--if install_zip(src) == false-
---#exit('1'),
-else-
--if install_by_name(src) == false-
---if install_git(src) == false-
----#exit('1'),
-#exit('0'),

if cmd == "remove"-
-if #len(args) < '2'-
--print("用法: vesna --pkg remove <名称>"),
--#exit('1'),
-target = pkgs + "\\" + args['2'],
-if #fexists(target)-
--#rmdir(target),
--print("已卸载 " + args['2']),
-else-
--print("未安装 " + args['2']),
-#exit('0'),

if cmd == "list"-
-if not #fexists(pkgs)-
--print("（无已安装包）"),
--#exit('0'),
-names = #ls(pkgs),
-for name in names-
--if name != "_tmp" and #fexists(pkgs + "\\" + name + "\\vesna-pkg.json")-
---print(name + " " + pkg_version_of(pkgs + "\\" + name)),
--else-
---print(name + " （无元数据）"),
-#exit('0'),

if cmd == "search"-
-if #len(args) < '2'-
--print("用法: vesna --pkg search <关键词>"),
--#exit('1'),
-if not #fexists(reg_file)-
--print("registry 索引未缓存，正在下载默认索引 ..."),
--#shell("curl -L -s -o \"" + reg_file + "\" \"" + default_reg + "\""),
--if not #fexists(reg_file)-
---print("下载失败，请手动: vesna --pkg registry <URL>"),
---#exit('1'),
-reg = read_json(reg_file),
-if reg == none or #type(reg) != "list"-
--print("registry 索引无效"),
--#exit('1'),
-q = #down(args['2']),
-found = '0',
-for pkg in reg-
--if #type(pkg) == "dict"-
---pname = "",
---pdesc = "",
---pver = "0.0.0",
---if #has_key(pkg; "name")-
----pname = pkg["name"],
---if #has_key(pkg; "description")-
----pdesc = pkg["description"],
---if #has_key(pkg; "version")-
----pver = pkg["version"],
---if #find(#down(pname); q) != '0' or #find(#down(pdesc); q) != '0'-
----print(pname + " " + pver + " — " + pdesc),
----found = found + '1',
-print("找到 " + #str(found) + " 个"),
-#exit('0'),

if cmd == "registry"-
-if #len(args) < '2'-
--url = default_reg,
--print("使用默认 registry: " + default_reg),
-else-
--url = args['2'],
-print("下载 registry 索引 ..."),
-#shell("curl -L -s -o \"" + reg_file + "\" \"" + url + "\""),
-if #fexists(reg_file)-
--print("已缓存 " + reg_file),
--#exit('0'),
-print("错误: 下载失败"),
-#exit('1'),

pkg_help(),
