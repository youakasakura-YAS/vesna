{
    "if": {
      "prefix": "if",
      "body": [
        "if ${1:condition}-",
        "-$0"
      ],
      "description": "if 块"
    },
    "if-else": {
      "prefix": "ife",
      "body": [
        "if ${1:condition}-",
        "-${2:print(\"yes\")}",
        "-else",
        "-${3:print(\"no\")}"
      ],
      "description": "if / else 块"
    },
    "while": {
      "prefix": "while",
      "body": [
        "while ${1:condition}-",
        "-$0"
      ],
      "description": "while 循环"
    },
    "for": {
      "prefix": "for",
      "body": [
        "for ${1:i} in ${2:list}-",
        "-$0"
      ],
      "description": "for 循环"
    },
    "def": {
      "prefix": "def",
      "body": [
        "def ${1:name}(${2:args})-",
        "-back(${3:value})"
      ],
      "description": "函数定义"
    },
    "try": {
      "prefix": "try",
      "body": [
        "try-",
        "-${1:expr}",
        "-catch ${2:e}",
        "-print(\"错误: \" + ${2:e})"
      ],
      "description": "try / catch"
    },
    "print": {
      "prefix": "print",
      "body": ["print(${1:value})"],
      "description": "print"
    },
    "interp": {
      "prefix": "f",
      "body": ["#f\"${1:text}(${2:var})\""],
      "description": "插值字符串"
    },
    "vesna": {
      "prefix": "vesna",
      "body": [
        "<vesna>",
        "$0",
        "</vesna>"
      ],
      "description": "Vesna 起止符"
    }
  }