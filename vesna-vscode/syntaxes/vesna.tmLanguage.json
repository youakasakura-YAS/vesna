{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vesna",
  "scopeName": "source.vesna",
  "patterns": [
    { "include": "#comments" },
    { "include": "#tags" },
    { "include": "#interp" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#booleans" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "tags": {
      "patterns": [
        { "name": "keyword.control", "match": "</?vesna>" }
      ]
    },
    "interp": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "#f\"",
          "end": "\"",
          "patterns": [
            { "name": "variable.parameter", "match": "\\([a-zA-Z_][a-zA-Z0-9_]*\\)" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric", "match": "'\\d+(\\.\\d+)?'|'\\.\\d+'" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function", "match": "#\\b(up|down|into|f|len|sub|split|join|find|replace|append|pop|keys|values|type|args|fread|fwrite|fappend|fexists|exit|trim|startswith|endswith|lines|repeat|sort|reverse|map|filter|reduce|slice|match|findall|gsub|search|ls|glob|stdin|has_key|str|int|float|bool|char_at|ord|chr|is_digit|is_alpha|is_alnum|is_space|lstrip|rstrip|title|capitalize|count|rfind|min|max|sum|abs|round|pow|contains|mkdir|copy|rmdir|rename|getenv|setenv|cwd|chdir|regwrite|regdelete|shell|path_clean)\\b" },
        { "name": "support.function", "match": "\\b(print|input)\\b(?=\\s*\\()" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control", "match": "\\b(if|elif|else|while|for|in|break|continue|back|def|try|catch|import)\\b" },
        { "name": "keyword.operator", "match": "\\b(and|or|not)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type", "match": "\\b(int|str|float|list|dict|bool)\\b" }
      ]
    },
    "booleans": {
      "patterns": [
        { "name": "constant.language", "match": "\\b(true|false)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator", "match": "\\+=|-=|\\*=|/=|\\.\\/|\\/\\.|\\/-|==|!=|>=|<=|[+\\-*/=<>]" }
      ]
    },
    "identifiers": {
      "patterns": [
        { "name": "variable.other", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b" }
      ]
    }
  }
}