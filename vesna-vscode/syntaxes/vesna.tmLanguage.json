{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vesna",
  "scopeName": "source.vesna",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#interp"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "</?vesna>"
        }
      ]
    },
    "interp": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "#f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "variable.parameter",
              "match": "\\([a-zA-Z_][a-zA-Z0-9_]*\\)"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric",
          "match": "'\\d+(\\.\\d+)?'|'\\.\\d+'"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function",
          "match": "#\\b(up|down|into|f|len|sub|split|join|find|replace|append|pop|keys|values|type|args|fread|fwrite|fappend|fexists|exit|trim|startswith|endswith|lines|repeat|sort|reverse|map|filter|reduce|slice|match|findall|gsub|search|ls|glob|stdin|has_key|str|int|float|bool|char_at|ord|chr|is_digit|is_alpha|is_alnum|is_space|lstrip|rstrip|title|capitalize|count|rfind|min|max|sum|abs|round|pow|contains|mkdir|copy|rmdir|rename|getenv|setenv|cwd|chdir|regwrite|regdelete|shell|path_clean|sqrt|floor|ceil|exp|log|log10|sin|cos|tan|sign|clamp|rand|randint|choice|hex|bin|oct|pad|lpad|rpad|format|hash|range|first|last|take|drop|set|flatten|zip|insert|remove|index_of|enumerate|concat|get|items|pop_key|is_str|is_int|is_float|is_bool|is_list|is_dict|is_none|is_group|now|date|sleep|ticks|platform|temp_dir|fremove|fmove|fsize|is_dir|is_file|mkdirs|base64_encode|base64_decode|url_encode|url_decode|each|all|any|find_first|sort_by|throw|assert|shuffle|regenv|cpdir|thread|thread_join|thread_count|lock|unlock|http_get|http_post|tcp_ping|bin_read|bin_write|bin_hex|bin_unhex|bin_base64_encode|bin_base64_decode|json_encode|json_decode|re_groups|sha256|aes_encrypt|aes_decrypt|proc_run|ffi_call|csv_parse|csv_build|ini_read|ini_write|xml_parse|ffi_call_s|call|date_format|parse_time|uuid|http_server|file_time|truncate|arch)\\b"
        },
        {
          "name": "support.function",
          "match": "\\b(print|input)\\b(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(if|elif|else|while|for|in|break|continue|back|def|try|catch|import)\\b"
        },
        {
          "name": "keyword.operator",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type",
          "match": "\\b(int|str|float|list|dict|bool)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator",
          "match": "\\+=|-=|\\*=|/=|\\.\\/|\\/\\.|\\/-|==|!=|>=|<=|[+\\-*/=<>]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}